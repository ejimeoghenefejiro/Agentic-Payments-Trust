{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "AutoProvisionUsers": false,
    "Development": {
      "Enabled": false,
      "SigningKey": ""
    },
    "StepUp": {
      "MaxAgeMinutes": 10,
      "AllowedAcrValues": []
    }
  },
  "Payments": {
    "Provider": "Mock",
    "Mode": "Test"
  },
  "Stripe": {
    "WebhookSecret": ""
  },
  "ConsumerPilot": {
    "Planning": {
      "MaximumReasoningTurns": 40,
      "MaximumToolCalls": 40,
      "TimeoutSeconds": 90
    },
    "Worker": {
      "Enabled": false,
      "IntervalSeconds": 30
    }
  },
  "ConsumerMemory": {
    "Enabled": false,
    "OutboxIntervalSeconds": 5,
    "Embedding": {
      "Model": "text-embedding-3-small",
      "Dimensions": 1536,
      "Endpoint": "https://api.openai.com/v1/"
    },
    "Qdrant": {
      "Url": "http://localhost:6333",
      "Collection": "consumer_memories"
    },
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false",
      "CacheTtlSeconds": 120
    }
  },
  "LivePurchase": {
    "Enabled": false,
    "MaxPilotAmountGbp": 5,
    "AllowedPrincipalIds": [],
    "AllowedMerchantIds": [],
    "RequireExplicitLiveConfirmation": true
  },
  "Operations": {
    "ReconciliationIntervalSeconds": 30,
    "ExternalExecutionEnabled": false,
    "GroceryExecutionEnabled": false,
    "RestaurantExecutionEnabled": false,
    "HomeServiceExecutionEnabled": false,
    "ThirdPartyFulfilmentEnabled": false
  },
  "Intelligence": {
    "SemanticMemory": {
      "Enabled": false,
      "Provider": "OpenAI",
      "Model": "text-embedding-3-small",
      "Dimensions": 1536,
      "Endpoint": "https://api.openai.com/v1/"
    }
  }
}
